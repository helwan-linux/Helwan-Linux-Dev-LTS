[Nemo Action]
Name=Count Lines
Comment=Display the number of lines in the selected file
Exec=bash -c 'lines=$(wc -l < "%F"); zenity --info --title="Line Count" --text="Lines: $lines\nFile: %F"'
Icon=text-x-script
Selection=single
Extensions=any;
Terminal=false


[Nemo Action]
Name=Install Package (zst)
Comment=Install Arch package
Exec=x-terminal-emulator -e bash -c 'sudo pacman -U "%F"; exec bash'
Icon=system-software-install
Selection=single
Extensions=pkg.tar.zst;
Terminal=false
