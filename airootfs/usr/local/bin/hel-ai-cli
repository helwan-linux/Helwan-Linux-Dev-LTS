#!/bin/bash

# ================================================
# hel-ai-cli — AI Terminal Assistant
# For Helwan Linux
# ================================================
# Powered by KING ABDO CLI (Groq + NVIDIA API)
# Author: King Abdo (A181-CODER)
# GitHub: https://github.com/A181-CODER
# "Built by the King, for the people of Helwan"
# ================================================

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

clear

echo -e "${BLUE}"
echo "  ██╗  ██╗███████╗██╗      █████╗ ██╗"
echo "  ██║  ██║██╔════╝██║     ██╔══██╗██║"
echo "  ███████║█████╗  ██║     ███████║██║"
echo "  ██╔══██║██╔══╝  ██║     ██╔══██║██║"
echo "  ██║  ██║███████╗███████╗██║  ██║██║"
echo "  ╚═╝  ╚═╝╚══════╝╚══════╝╚═╝  ╚═╝╚═╝"
echo -e "${NC}"
echo -e "${CYAN}  👑 hel-ai-cli — Powered by KING ABDO${NC}"
echo -e "${GREEN}  Groq + NVIDIA API | Helwan Linux v1.0${NC}"
echo -e "${YELLOW}  GitHub: github.com/A181-CODER${NC}"
echo ""

# Check Node.js
if ! command -v node &> /dev/null; then
    echo "Installing Node.js..."
    sudo pacman -S nodejs npm --noconfirm
fi

# Setup if first time
if [ ! -d "$HOME/.hel-ai-cli" ]; then
    echo -e "${CYAN}Setting up hel-ai-cli by King Abdo...${NC}"
    git clone https://github.com/A181-CODER/KING-ABDO-CLI.git "$HOME/.hel-ai-cli"
    cd "$HOME/.hel-ai-cli" && npm install
    echo -e "${GREEN}Ready! 👑${NC}"
fi

# Launch
cd "$HOME/.hel-ai-cli" && npm start